{
  "name": "realtime-collaborative-coding",
  "version": "0.4.0",
  "displayName": "Collab Review",
  "description": "Watch shared Python edits, copy independent solutions, and compare correctness and performance in VS Code.",
  "publisher": "FrOxyz06",
  "engines": {
    "vscode": "^1.138.0"
  },
  "main": "./out/extension.js",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/vscode": "^1.138.0",
    "typescript": "^7.0.2",
    "@vscode/test-electron": "^3.1.0",
    "jszip": "3.10.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "collab.openMenu",
        "title": "Collab: Open Menu"
      },
      {
        "command": "collab.tryDemo",
        "title": "Collab: Try Starter Demo"
      },
      {
        "command": "collab.copyInvite",
        "title": "Collab: Copy Session Invite"
      },
      {
        "command": "collab.checkSetup",
        "title": "Collab: Check Python Setup"
      },
      {
        "command": "collab.openGuide",
        "title": "Collab: Open Beta Guide"
      },
      {
        "command": "collab.sendFeedback",
        "title": "Collab: Give Feedback"
      },
      {
        "command": "collab.createProposal",
        "title": "Collab: Create Proposal"
      },
      {
        "command": "collab.reviewProposal",
        "title": "Collab: Review Proposal"
      },
      {
        "command": "collab.benchmarkProposal",
        "title": "Collab: Benchmark Proposal"
      },
      {
        "command": "collab.acceptProposal",
        "title": "Collab: Accept Proposal"
      },
      {
        "command": "collab.rejectProposal",
        "title": "Collab: Reject Proposal"
      },
      {
        "command": "collab.hostSession",
        "title": "Collab: Host Session"
      },
      {
        "command": "collab.joinSession",
        "title": "Collab: Join Session"
      },
      {
        "command": "collab.sendSessionProposal",
        "title": "Collab: Send Session Proposal"
      },
      {
        "command": "collab.reviewSessionProposal",
        "title": "Collab: Review Session Proposal"
      },
      {
        "command": "collab.sessionStatus",
        "title": "Collab: Session Status"
      },
      {
        "command": "collab.endSession",
        "title": "Collab: End Session"
      },
      {
        "command": "collab.startLiveSharing",
        "title": "Collab: Start Live Sharing"
      },
      {
        "command": "collab.pauseLiveSharing",
        "title": "Collab: Pause Live Sharing"
      },
      {
        "command": "collab.watchSharedFile",
        "title": "Collab: Watch Shared File"
      },
      {
        "command": "collab.copySharedFile",
        "title": "Collab: Copy Shared File"
      },
      {
        "command": "collab.compareWithFriend",
        "title": "Collab: Compare My Solution with Friend"
      },
      {
        "command": "collab.exportComparison",
        "title": "Collab: Export Comparison"
      }
    ],
    "configuration": {
      "title": "Collab Review",
      "properties": {
        "collab.pythonPath": {
          "type": "string",
          "default": "python",
          "scope": "machine",
          "description": "Python 3.10+ executable path (no command-line arguments)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc",
    "test": "npm run compile && node --test tests/*.test.cjs",
    "test:python": "python -m unittest discover -s tests -p test_*.py -v",
    "test:editor": "npm run compile && node scripts/run-editor-tests.cjs",
    "demo": "node scripts/benchmark-demo.cjs",
    "vscode:prepublish": "npm run compile",
    "package": "npx --yes @vscode/vsce@3.6.2 package --no-dependencies --skip-license --out collab-review-0.4.0.vsix",
    "test:package": "node scripts/test-package.cjs"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Code execution and applying proposals require workspace trust."
    },
    "virtualWorkspaces": false
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FrOxyz06/realtime-collaborative-coding.git"
  },
  "preview": true,
  "categories": [
    "Other"
  ],
  "keywords": [
    "collaboration",
    "python",
    "code review",
    "benchmark"
  ],
  "bugs": {
    "url": "https://github.com/FrOxyz06/realtime-collaborative-coding/issues"
  },
  "homepage": "https://github.com/FrOxyz06/realtime-collaborative-coding#readme",
  "activationEvents": [
    "onStartupFinished"
  ]
}
